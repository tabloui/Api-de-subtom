{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/index.py" },
    { "src": "/api", "dest": "/index.py" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "index.py": {
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
